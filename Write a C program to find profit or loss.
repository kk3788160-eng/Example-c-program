#include <stdio.h>

int main() {
    float costPrice, sellingPrice, amount;

    // Input cost price and selling price
    printf("Enter Cost Price (CP): Rs. ");
    scanf("%f", &costPrice);
    printf("Enter Selling Price (SP): Rs. ");
    scanf("%f", &sellingPrice);

    // Calculate profit or loss
    if (sellingPrice > costPrice) {
        amount = sellingPrice - costPrice;
        printf("You made a Profit of Rs. %.2f\n", amount);
    } else if (costPrice > sellingPrice) {
        amount = costPrice - sellingPrice;
        printf("You incurred a Loss of Rs. %.2f\n", amount);
    } else {
        printf("No Profit, No Loss. You broke even.\n");
    }

    return 0;
}
