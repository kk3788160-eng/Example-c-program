#include <stdio.h>

int main() {
    int number, count = 0;

    // Input a number
    printf("Enter a number: ");
    scanf("%d", &number);

    // Handle negative numbers
    if (number < 0) {
        number = -number;
    }

    // Count digits
    if (number == 0) {
        count = 1; // 0 has 1 digit
    } else {
        while (number > 0) {
            number = number / 10; // Remove last digit
            count++;
        }
    }

    printf("Number of digits: %d\n", count);

    return 0;
}
