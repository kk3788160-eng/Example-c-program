#include <stdio.h>

int main() {
    int n;
    int sum = 0;

    // Input the value of n
    printf("Enter a positive integer n: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Please enter a positive number.\n");
    } else {
        // Calculate sum using a for loop
        for (int i = 1; i <= n; i++) {
            sum += i;
        }

        printf("Sum of first %d natural numbers is: %d\n", n, sum);
    }

    return 0;
}
