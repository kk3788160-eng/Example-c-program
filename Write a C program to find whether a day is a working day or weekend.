#include <stdio.h>

int main() {
    int day;

    // Input day number from the user
    printf("Enter day number (1 for Monday, 2 for Tuesday, ..., 7 for Sunday): ");
    scanf("%d", &day);

    // Check if it's a working day or weekend
    if (day >= 1 && day <= 5) {
        printf("Day %d is a working day.\n", day);
    } else if (day == 6 || day == 7) {
        printf("Day %d is a weekend.\n", day);
    } else {
        printf("Invalid day number! Please enter a number between 1 and 7.\n");
    }

    return 0;
}
