#include <stdio.h>
#include <string.h>

int main() {
    char str[100], rev[100];
    int len, j;

    printf("Enter a string: ");
    scanf(" %[^\n]s", str);

    len = strlen(str);
    for (int i = 0, j = len - 1; i < len; i++, j--) {
        rev[i] = str[j];
    }
    rev[len] = '\0';

    printf("Reversed string: %s\n", rev);

    return 0;
}
