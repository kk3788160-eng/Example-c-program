#include <stdio.h>

int main() {
    int marks;

    // Input marks from the user
    printf("Enter marks (0-100): ");
    scanf("%d", &marks);

    // Check if marks are valid
    if (marks < 0 || marks > 100) {
        printf("Invalid marks entered.\n");
    } else {
        // Determine grade
        if (marks >= 90) {
            printf("Grade: A+\n");
        } else if (marks >= 80) {
            printf("Grade: A\n");
        } else if (marks >= 70) {
            printf("Grade: B+\n");
        } else if (marks >= 60) {
            printf("Grade: B\n");
        } else if (marks >= 50) {
            printf("Grade: C\n");
        } else if (marks >= 40) {
            printf("Grade: D\n");
        } else {
            printf("Grade: F\n");
        }
    }

    return 0;
}
