#include <stdio.h>

int main() {
    int number;

    // Input the number for which the table is to be displayed
    printf("Enter a number to display its multiplication table: ");
    scanf("%d", &number);

    printf("\nMultiplication table of %d:\n", number);

    // Display multiplication table from 1 to 10
    for (int i = 1; i <= 10; i++) {
        printf("%d x %d = %d\n", number, i, number * i);
    }

    return 0;
}
