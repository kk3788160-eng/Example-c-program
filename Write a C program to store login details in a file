#include <stdio.h>

int main() {
    FILE *fp;
    char username[20], password[20];

    fp = fopen("login.txt", "w");

    printf("Enter Username: ");
    scanf("%s", username);
    printf("Enter Password: ");
    scanf("%s", password);

    fprintf(fp, "%s %s", username, password);
    fclose(fp);

    printf("Login details saved.");
    return 0;
}
