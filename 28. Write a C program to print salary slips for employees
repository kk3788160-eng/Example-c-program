#include <stdio.h>

int main() {
    char name[50];
    int empID;
    float basicSalary, hra, da, tax, netSalary;

    // Input employee details
    printf("Enter Employee Name: ");
    scanf(" %[^\n]s", name); // to read full name with spaces
    printf("Enter Employee ID: ");
    scanf("%d", &empID);
    printf("Enter Basic Salary: Rs. ");
    scanf("%f", &basicSalary);

    // Input allowances and deductions
    printf("Enter HRA (House Rent Allowance): Rs. ");
    scanf("%f", &hra);
    printf("Enter DA (Dearness Allowance): Rs. ");
    scanf("%f", &da);
    printf("Enter Tax Deductions: Rs. ");
    scanf("%f", &tax);

    // Calculate net salary
    netSalary = basicSalary + hra + da - tax;

    // Print salary slip
    printf("\n------------------- SALARY SLIP -------------------\n");
    printf("Employee Name: %s\n", name);
    printf("Employee ID  : %d\n", empID);
    printf("Basic Salary : Rs. %.2f\n", basicSalary);
    printf("HRA          : Rs. %.2f\n", hra);
    printf("DA           : Rs. %.2f\n", da);
    printf("Tax Deducted : Rs. %.2f\n", tax);
    printf("--------------------------------------------------\n");
    printf("Net Salary   : Rs. %.2f\n", netSalary);
    printf("--------------------------------------------------\n");

    return 0;
}
