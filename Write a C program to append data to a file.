#include <stdio.h>

int main() {
    FILE *fp;
    char text[100];

    fp = fopen("data.txt", "a");   // append mode

    if (fp == NULL) {
        printf("File cannot be opened.\n");
        return 1;
    }

    printf("Enter text to append: ");
    gets(text);

    fprintf(fp, "%s\n", text);

    fclose(fp);
    printf("Data appended successfully.\n");

    return 0;
}
